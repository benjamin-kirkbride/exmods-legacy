# Ignore rules for this repo.
# Generic .NET/IDE rules first, repo-specific rules second.

#
# .NET/IDE
#

# User-specific IDE state.
*.rsuser
*.suo
*.user
*.sln.docstates
*.DotSettings.user

# Build results.
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/

# Logs and temporaries.
*.log
*.tlog
*.tmp

# Visual Studio / Rider caches.
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper

# Visual Studio cache files.
# files ending in .cache can be ignored.
*.[Cc]ache
# but keep track of directories ending in .cache.
!?*.[Cc]ache/
# ...and .lscache, which the pattern above does NOT match.
*.lscache

# Test and coverage output.
[Tt]est[Rr]esult*/
/coverage*.json
/coverage*.xml
/coverage*.info
*.coverage
*.coveragexml

# VS Code: ignore everything except the shared workspace files.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

#
# Repo-specific
#

# Downloaded Vintage Story installs + cached archives. No trailing slash: in the workspace this is
# a symlink to the shared install, not a directory, and a directory-only pattern does not match a
# symlink.
/.game

# Vintage Story data dir the game generates under the repo via --dataPath. No trailing slash: a
# second checkout links it to the first one's, so both play the same worlds.
/.gamedata

# Self-contained .NET runtimes scripts/run-tests.* provisions when the system host lacks one.
# Symlinked in the workspace - see /.game above.
/.dotnet

# Release zips the Cake build publishes.
/dist/Releases/

# draw.io writes a .$-prefixed lock/backup beside the diagram it has open.
.$*.drawio.bkp

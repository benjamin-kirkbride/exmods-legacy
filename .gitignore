# Ignore rules for this repo.
# Generic .NET/IDE rules first, repo-specific rules second.

#
# .NET/IDE
#

# User-specific IDE state.
*.rsuser
*.suo
*.user
*.sln.docstates
*.DotSettings.user

# Build results.
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/

# Logs and temporaries.
*.log
*.tlog
*.tmp

# Visual Studio / Rider caches.
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper

# Visual Studio cache files.
# files ending in .cache can be ignored.
*.[Cc]ache
# but keep track of directories ending in .cache.
!?*.[Cc]ache/
# ...and .lscache, which the pattern above does NOT match.
*.lscache

# Test and coverage output.
[Tt]est[Rr]esult*/
/coverage*.json
/coverage*.xml
/coverage*.info
*.coverage
*.coveragexml

# VS Code: ignore everything except the shared workspace files.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

#
# Repo-specific
#

# Downloaded Vintage Story installs + cached archives, when the checkout is outside a workspace.
/.game

# Game data an older launch configuration wrote here.
/.gamedata

# Self-contained .NET runtimes scripts/run-tests.* provisions when the system host lacks one.
/.dotnet

# Release zips the Cake build publishes.
/dist/Releases/

# Per-branch test counts scripts/run-tests.* compare each run against.
/.exmod/

# extools, cloned by scripts/exmod.sh or scripts/exmod.ps1 when no sibling checkout is found.
/.extools/

# draw.io writes a .$-prefixed lock/backup beside the diagram it has open.
.$*.drawio.bkp

# Trace text a pin run recorded that differs from the committed trace beside it.
*.received.trace

# Setup recordings a scenario run wrote that differ from the committed ones beside them.
tests/Integration.Tests/Setups/Recordings/**/*.received.json

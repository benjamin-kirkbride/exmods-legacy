<Project>
  <!--
    ============================================================================================
    The supported VintageStory versions live here, and only here; the "version manifest" region
    below is the only place to edit when the version set changes.

    To add a version: append its TFM to $(AllGameTfms); its per-version row (game version, folder
    slug, install env var) lives in exlib's build/ExpandedLib.props and its GAME_GE_<ver> constant
    in build/ExpandedLib.targets.
    To promote a new primary (e.g. when 1.22 becomes legacy and 1.23 arrives): point
    $(CurrentGameTfm)/$(CurrentGameVer) at the new row (leaving the old one in $(AllGameTfms)).

    The csprojs read $(CurrentGameTfm)/$(AllGameTfms) for TargetFramework(s); $(GamePath),
    $(GameVer), $(GameVersion) and the GAME_GE_<major>_<minor> compile constants derive from the
    TFM in exlib's build files, imported below and from Directory.Build.targets. These three are
    set unconditionally, so the guarded defaults of the same name in ExpandedLib.props back off.
    ============================================================================================
  -->

  <!-- ===================== Version manifest (edit only this region) ===================== -->
  <PropertyGroup>
    <CurrentGameTfm>net10.0</CurrentGameTfm>
    <CurrentGameVer>1.22.0</CurrentGameVer>
    <AllGameTfms>net7.0;net8.0;net10.0</AllGameTfms>
  </PropertyGroup>
  <!-- =================== end version manifest =================== -->

  <!-- The workspace switch: the Directory.Build.props above this repository, when there is one, sets
       $(ExlibRoot) to the exlib checkout beside it (source mode). A standalone clone has none, so
       $(ExlibRoot) stays empty and every project takes ExpandedLib from its packages. -->
  <PropertyGroup>
    <_WorkspaceBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_WorkspaceBuildProps>
  </PropertyGroup>
  <Import
    Project="$(_WorkspaceBuildProps)"
    Condition="Exists('$(_WorkspaceBuildProps)')"
  />

  <!-- The per-version rows, GamePath resolution, provisioning and the capability constants ship in
       the ExpandedLib package (build/ExpandedLib.props and .targets); source mode imports the same
       files from the checkout. In package mode the PackageReference imports them. -->
  <Import
    Project="$(ExlibRoot)build\ExpandedLib.props"
    Condition="'$(ExlibRoot)' != ''"
  />
</Project>

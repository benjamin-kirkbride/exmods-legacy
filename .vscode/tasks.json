{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "launch-prep (latest)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "provision-game (1.22)",
        "stage-mods (latest)"
      ],
      "problemMatcher": []
    },
    {
      "label": "stage-mods (latest)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/exmod.sh",
        "stage"
      ],
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/exmod.ps1",
          "stage"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Publish mods",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/dist/CakeBuild/CakeBuild.csproj"
      ],
      "problemMatcher": "$msCompile"
    },

    // ----------------------------------------------------------------------------------------
    // Test runners - separate, independently-runnable targets per game version. Each builds the
    // test projects for that version (auto-provisioning its game binaries on demand) and runs the
    // suite; projects run in parallel. "Test: all" runs every version concurrently. Pick one from
    // "Run Test Task", or run any via "Run Task".
    // ----------------------------------------------------------------------------------------
    {
      "label": "Test: latest (1.22)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-tests.ps1",
        "-Version",
        "latest"
      ],
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/run-tests.sh", "latest"]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: 1.21 (legacy)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-tests.ps1",
        "-Version",
        "1.21"
      ],
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/run-tests.sh", "1.21"]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: 1.20 (legacy)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-tests.ps1",
        "-Version",
        "1.20"
      ],
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/run-tests.sh", "1.20"]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: all versions (parallel)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-tests.ps1",
        "-Version",
        "all"
      ],
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/run-tests.sh", "all"]
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test: coverage (latest + gate)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-tests.ps1",
        "-Coverage"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "provision-game (1.22)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/exmod.sh",
        "provision",
        "game",
        "-Version",
        "1.22",
        "-Kind",
        "client"
      ],
      "windows": {
        "command": "pwsh",

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Steelmaking Expanded (latest)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "launch-prep (latest)",
      "program": "${env:HOME}/.local/share/exmod/game/1.22/Vintagestory.dll",
      "args": [
        "--tracelog",
        "--dataPath",
        "${env:HOME}/.local/share/exmod/data/default",
        "--logPath",
        "${env:HOME}/.local/share/exmod/data/default/Logs/${workspaceFolderBasename}",
        "--addModPath",
        "${workspaceFolder}/bin/Mods"
      ],
      "cwd": "${workspaceFolder}",
      "linux": {
        "env": { "WAYLAND_DISPLAY": "none" },
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder}",
          "pipeProgram": "bash",
          "pipeArgs": ["${workspaceFolder}/scripts/exmod.sh", "debug-adapter"],
          "debuggerPath": "vsdbg",
          "quoteArgs": false
        }
      },
      "osx": {
        "program": "${env:HOME}/Library/Application Support/exmod/game/1.22/Vintagestory.dll",
        "args": [
          "--tracelog",
          "--dataPath",
          "${env:HOME}/Library/Application Support/exmod/data/default",
          "--logPath",
          "${env:HOME}/Library/Application Support/exmod/data/default/Logs/${workspaceFolderBasename}",
          "--addModPath",
          "${workspaceFolder}/bin/Mods"
        ]
      },
      "windows": {
        "program": "${env:LOCALAPPDATA}/exmod/game/1.22/Vintagestory.exe",
        "args": [
          "--tracelog",
          "--dataPath",
          "${env:LOCALAPPDATA}/exmod/data/default",
          "--logPath",
          "${env:LOCALAPPDATA}/exmod/data/default/Logs/${workspaceFolderBasename}",
          "--addModPath",
          "${workspaceFolder}/bin/Mods"
        ]
      },
      "stopAtEntry": false,
      "console": "internalConsole",
      "requireExactSource": false
    },
